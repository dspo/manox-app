#!/usr/bin/env bash

set -euo pipefail

# Bundle manox — and the cx CLI inside it — as a macOS .app.
#
# Usage: script/bundle-mac [options]
# Options:
#   --harness <pi|manox>  Which harness core the app is built on (default: manox).
#                         The flavors get distinct names/identifiers from
#                         [package.metadata.bundle.harness.<h>] in
#                         apps/desktop/manox/Cargo.toml, so both can coexist in
#                         /Applications.
#   -d    Compile in debug mode
#   -o    Open the resulting .app after bundling
#   -i    Install the .app to /Applications
#   --cx-link-dir <dir>  Directory whose cx symlink points into the bundle
#                        (default: ~/.local/bin)
#   --no-cx-link         Do not create the cx symlink
#   -h    Display this help and exit
#
# The cx CLI ships as Contents/MacOS/cx — a nested executable beside the app
# binary, so the signature covers it as code — and is linked into
# <cx-link-dir>/cx, making a terminal `cx` run this app's build. An existing
# non-symlink at the link path is moved aside to cx.bak-<timestamp>.

build_flag="--release"
target_dir="release"
open_result=false
install_result=false
harness="manox"
cx_link_dir="$HOME/.local/bin"
cx_link=true

help_info() {
    echo "
Usage: ${0##*/} [options]
Bundle manox (with the cx CLI inside) as a macOS .app.

Options:
  --harness <pi|manox>  Harness core to build (default: manox)
  -d    Compile in debug mode
  -o    Open the resulting .app after bundling
  -i    Install the .app to /Applications
  --cx-link-dir <dir>   Directory whose cx symlink points into the bundle
                        (default: ~/.local/bin)
  --no-cx-link          Do not create the cx symlink
  -h    Display this help and exit
"
}

set_harness() {
    harness="$1"
    if [[ "$harness" != "pi" && "$harness" != "manox" ]]; then
        echo "Error: --harness expects 'pi' or 'manox' (got '${harness}')"
        exit 1
    fi
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --harness)
            [[ $# -ge 2 ]] || { echo "Error: --harness requires a value"; exit 1; }
            set_harness "$2"; shift;;
        --harness=*) set_harness "${1#--harness=}";;
        --cx-link-dir)
            [[ $# -ge 2 && -n "$2" ]] || { echo "Error: --cx-link-dir requires a value"; exit 1; }
            cx_link_dir="$2"; shift;;
        --cx-link-dir=*)
            cx_link_dir="${1#--cx-link-dir=}"
            [[ -n "${cx_link_dir}" ]] || { echo "Error: --cx-link-dir requires a value"; exit 1; };;
        --no-cx-link) cx_link=false;;
        -d) build_flag=""; target_dir="debug";;
        -o) open_result=true;;
        -i) install_result=true;;
        -h|--help) help_info; exit 0;;
        *) echo "Error: unknown option '$1'"; help_info; exit 1;;
    esac
    shift
done

# --- Detect target triple ---
version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }

if [[ "$target_triple" != *-apple-darwin ]]; then
    echo "Error: this script only runs on macOS (detected $target_triple)"
    exit 1
fi

# --- Build ---
echo "Building manox binary (harness: ${harness})"
feature_args=()
if [[ "$harness" == "pi" ]]; then
    feature_args=(--no-default-features --features harness-pi)
fi
cargo build ${build_flag} ${feature_args[@]+"${feature_args[@]}"} --package manox --target "$target_triple"

# The cx CLI comes from the same workspace/lock, but builds in its own cargo
# invocation: the harness feature flags above are manox-only.
echo "Building cx CLI"
cargo build ${build_flag} --package cx-cli --target "$target_triple"

# --- Read bundle configuration from Cargo.toml ---
# Single source of truth: [package.metadata.bundle] in apps/desktop/manox/Cargo.toml.
bundle_toml="apps/desktop/manox/Cargo.toml"
# Extract values from the bundle section (not the [package] section).
# The bundle "name" is the display name ("Manox"), distinct from the crate
# name ("manox"). Per-harness tables ([package.metadata.bundle.harness.<h>])
# override the base table so each flavor gets its own name/identifier.
read_bundle_value() {
    local section="$1" key="$2"
    awk -v section="$section" -v key="$key" '
        $0 == "[" section "]" { in_section = 1; next }
        /^\[/ { in_section = 0 }
        in_section && $1 == key && $2 == "=" {
            line = $0
            sub(/^[^"]*"/, "", line)
            sub(/".*$/, "", line)
            print line
            exit
        }
    ' "${bundle_toml}"
}
bundle_id=$(read_bundle_value "package.metadata.bundle.harness.${harness}" "identifier")
[[ -n "${bundle_id}" ]] || bundle_id=$(read_bundle_value "package.metadata.bundle" "identifier")
app_name=$(read_bundle_value "package.metadata.bundle.harness.${harness}" "name")
[[ -n "${app_name}" ]] || app_name=$(read_bundle_value "package.metadata.bundle" "name")
# version is workspace-inherited; resolve via cargo metadata
app_version=$(cargo metadata --format-version 1 --no-deps 2>/dev/null \
    | python3 -c "import sys,json; pkgs=json.load(sys.stdin)['packages']; \
                   p=[x for x in pkgs if x['name']=='manox']; \
                   print(p[0]['version'] if p else '0.1.0')")

# --- Determine paths ---
app_path="target/${target_triple}/${target_dir}/${app_name}.app"
macos_dir="${app_path}/Contents/MacOS"
resources_dir="${app_path}/Contents/Resources"
icon_resources_dir="apps/desktop/manox/resources"

# --- Assemble .app bundle ---
echo "Creating .app bundle at ${app_path}"
rm -rf "${app_path}"
mkdir -p "${macos_dir}" "${resources_dir}"

# Copy binaries: the app binary plus the cx CLI as a nested executable. Nested
# code belongs in Contents/MacOS — a Mach-O under Resources is sealed as a plain
# resource, stays unsigned, and cannot execute on Apple Silicon.
cp "target/${target_triple}/${target_dir}/manox" "${macos_dir}/manox"
cp "target/${target_triple}/${target_dir}/cx" "${macos_dir}/cx"
chmod 755 "${macos_dir}/cx"

# Copy icons (if present)
if [[ -f "${icon_resources_dir}/app-icon.icns" ]]; then
    cp "${icon_resources_dir}/app-icon.icns" "${resources_dir}/app-icon.icns"
elif [[ -f "${icon_resources_dir}/app-icon@2x.png" ]]; then
    cp "${icon_resources_dir}/app-icon.png" "${resources_dir}/app-icon.png" 2>/dev/null || true
    cp "${icon_resources_dir}/app-icon@2x.png" "${resources_dir}/app-icon@2x.png"
fi

# Copy entitlements into the bundle
if [[ -f "${icon_resources_dir}/manox.entitlements" ]]; then
    cp "${icon_resources_dir}/manox.entitlements" "${resources_dir}/manox.entitlements"
fi

# --- Generate Info.plist ---
icon_file="app-icon.icns"
if [[ ! -f "${resources_dir}/app-icon.icns" ]]; then
    icon_file="app-icon@2x.png"
fi

cat > "${app_path}/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleExecutable</key>
    <string>manox</string>
    <key>CFBundleIdentifier</key>
    <string>${bundle_id}</string>
    <key>CFBundleName</key>
    <string>${app_name}</string>
    <key>CFBundleDisplayName</key>
    <string>${app_name}</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>${app_version}</string>
    <key>CFBundleVersion</key>
    <string>${app_version}</string>
    <key>CFBundleIconFile</key>
    <string>${icon_file}</string>
    <key>CFBundleSupportedPlatforms</key>
    <array>
        <string>MacOSX</string>
    </array>
    <key>LSMinimumSystemVersion</key>
    <string>10.15.7</string>
    <key>NSHighResolutionCapable</key>
    <true/>
    <key>NSSupportsAutomaticGraphicsSwitching</key>
    <true/>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright 2024-2026 DSPo. All rights reserved.</string>
</dict>
</plist>
PLIST

echo "Info.plist written to ${app_path}/Contents/Info.plist"

# --- Code signing ---
# Ad-hoc sign with entitlements (required for JIT / unsigned-executable-memory
# that GPUI uses for runtime shaders). A proper Apple Developer certificate
# signing can override this if env vars are present.
#
# Nested executables are signed before the bundle that contains them, and
# without the bundle's entitlements: the outer signature seals the nested
# signature as it stands, while a single --deep pass would copy the app's JIT
# entitlements onto it. The outer pass runs without --deep, so a nested binary
# nobody signed fails the bundle loudly instead of shipping one that cannot
# execute on Apple Silicon.
entitlements_path="${icon_resources_dir}/manox.entitlements"
nested_cx="${macos_dir}/cx"

if [[ -n "${MACOS_CERTIFICATE:-}" && -n "${MACOS_CERTIFICATE_PASSWORD:-}" ]]; then
    echo "Setting up keychain for code signing..."
    security create-keychain -p "$MACOS_CERTIFICATE_PASSWORD" manox.keychain || true
    security default-keychain -s manox.keychain
    security unlock-keychain -p "$MACOS_CERTIFICATE_PASSWORD" manox.keychain
    security set-keychain-settings manox.keychain
    echo "$MACOS_CERTIFICATE" | base64 --decode > /tmp/manox-certificate.p12
    security import /tmp/manox-certificate.p12 -k manox.keychain -P "$MACOS_CERTIFICATE_PASSWORD" -T /usr/bin/codesign
    rm /tmp/manox-certificate.p12
    security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "$MACOS_CERTIFICATE_PASSWORD" manox.keychain

    function cleanup_keychain() {
        echo "Cleaning up keychain"
        security default-keychain -s login.keychain
        security delete-keychain manox.keychain || true
    }
    trap cleanup_keychain EXIT

    echo "Signing the cx CLI"
    /usr/bin/codesign --force --timestamp --options runtime \
        --sign "${MACOS_SIGNING_IDENTITY:-}" "${nested_cx}" -v

    echo "Code signing with Apple Developer certificate"
    /usr/bin/codesign --force --timestamp --options runtime \
        --entitlements "${entitlements_path}" \
        --sign "${MACOS_SIGNING_IDENTITY:-}" "${app_path}" -v

    # Clear the trap since cleanup is done
    trap - EXIT
    cleanup_keychain
else
    echo "Signing the cx CLI (ad-hoc)"
    codesign --force --sign - "${nested_cx}" -v

    echo "Ad-hoc signing with entitlements (no Apple Developer certificate)"
    codesign --force \
        --entitlements "${entitlements_path}" \
        --sign - "${app_path}" -v
fi

echo ""
echo "Bundle complete: ${app_path}"
echo "Binary:  ${macos_dir}/manox"
echo "cx CLI:  ${macos_dir}/cx"
echo ""

if [[ "$install_result" = true ]]; then
    install_dest="/Applications/${app_name}.app"
    echo "Installing to ${install_dest}"
    rm -rf "${install_dest}"
    cp -R "${app_path}" "${install_dest}"
    echo "Installed: ${install_dest}"
    app_path="${install_dest}"
fi

if [[ "$cx_link" = true ]]; then
    # Linked after the optional install so the link follows the copy the user
    # actually runs (/Applications) rather than the build-tree bundle.
    link_dir="${cx_link_dir/#\~/$HOME}"
    # A relative link directory resolves against the repo root otherwise.
    [[ "${link_dir}" = /* ]] || link_dir="$(pwd)/${link_dir}"
    link_path="${link_dir}/cx"
    link_target="$(cd "$(dirname "${app_path}")" && pwd)/$(basename "${app_path}")/Contents/MacOS/cx"
    mkdir -p "${link_dir}"
    if [[ -e "${link_path}" && ! -L "${link_path}" ]]; then
        backup="${link_path}.bak-$(date +%Y%m%d%H%M%S)"
        mv "${link_path}" "${backup}"
        echo "Moved existing ${link_path} to ${backup}"
    fi
    ln -sfn "${link_target}" "${link_path}"
    echo "Linked: ${link_path} -> ${link_target}"
    if [[ "$install_result" != true ]]; then
        echo "Note: the link points into the build tree; re-run with -i to point it at /Applications."
    fi
    case ":${PATH}:" in
        *":${link_dir}:"*) ;;
        *) echo "Warning: ${link_dir} is not in PATH — add it to run cx from a shell" ;;
    esac
fi

if [[ "$open_result" = true ]]; then
    echo "Opening ${app_path}"
    open "${app_path}"
fi
