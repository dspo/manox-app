#!/usr/bin/env bash

set -euo pipefail

# Bundle manox and the cx CLI as a Fedora-family RPM — the rpmbuild analog of
# bundle-deb.
#
# Usage: script/bundle-rpm [options]
# Options:
#   -d    Compile in debug mode
#   -i    Install the RPM system-wide (sudo dnf install ./<rpm>)
#   -o    Run the app after bundling (from the build tree, not the install)
#   -h    Display this help and exit
#
# Installed layout:
#   /usr/bin/<exe>                                   the manox binary
#   /usr/bin/cx                                      the cx CLI, same build
#   /usr/share/applications/<bundle-id>.desktop      desktop entry
#   /usr/share/icons/hicolor/{128x128,256x256}/apps/<bundle-id>.png
#
# Identity comes from [package.metadata.bundle] in apps/desktop/manox/Cargo.toml
# (the same single source of truth bundle-mac and bundle-deb read); the
# executable name is the bundle display name lowercased with spaces mapped to
# dashes, so future flavor bundles can coexist as distinct /usr/bin entries.
#
# Runtime Requires are generated by rpmbuild itself: the Red Hat ELF dependency
# generator records every DT_NEEDED soname and versioned symbol of both binaries
# as a Requires, which is the same link set bundle-deb reconstructs by hand with
# ldd + dpkg -S. The script prints nothing about them, but warns if the set came
# out empty.
#
# Note: the pi-harness flavor metadata still exists but its cargo feature was
# removed — bundle-mac's --harness option is stale; this script deliberately has
# no flavor switch.

build_flag="--release"
target_dir="release"
install_result=false
run_result=false

help_info() {
    echo "
Usage: ${0##*/} [options]
Bundle manox as a Fedora-family RPM.

Options:
  -d    Compile in debug mode
  -i    Install the RPM system-wide (sudo dnf install)
  -o    Run the app after bundling (from the build tree)
  -h    Display this help and exit
"
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -d) build_flag=""; target_dir="debug";;
        -i) install_result=true;;
        -o) run_result=true;;
        -h|--help) help_info; exit 0;;
        *) echo "Error: unknown option '$1'"; help_info; exit 1;;
    esac
    shift
done

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# --- Platform guard ---
version_info=$(rustc --version --verbose)
host_line=$(echo "$version_info" | grep host)
target_triple=${host_line#*: }

if [[ "$target_triple" != *-linux-* ]]; then
    echo "Error: this script only runs on Linux (detected $target_triple)"
    exit 1
fi
if ! command -v rpmbuild >/dev/null 2>&1; then
    echo "Error: rpmbuild not found — install the rpm-build package (or run on a Fedora derivative)"
    exit 1
fi
# Fedora's brp-* post-install hooks pass the buildroot to their helpers
# unquoted, so a space anywhere above target/rpm makes the build fail far from
# its cause ("Path ... does not start with RPM_BUILD_ROOT"); stop it here.
if [[ "${ROOT}" == *[[:space:]]* ]]; then
    echo "Error: the checkout path contains whitespace ('${ROOT}') — rpmbuild's brp hooks cannot build there"
    exit 1
fi
# The desktop integration and the %{?dist} release suffix follow Fedora-family
# packaging conventions; another RPM system still yields an installable package,
# but not the one this script documents.
if [[ -r /etc/os-release ]] && ! grep -qE '^(ID|ID_LIKE)="?(fedora|rhel|centos)' /etc/os-release; then
    echo "Warning: /etc/os-release does not look Fedora-family — this RPM targets Fedora/RHEL/CentOS Stream"
fi

# --- Build ---
echo "Building manox and cx binaries"
cargo build ${build_flag} --package manox --package cx-cli
bin_path="target/${target_dir}/manox"
cx_bin_path="target/${target_dir}/cx"
[[ -f "${bin_path}" ]] || { echo "Error: ${bin_path} missing after build"; exit 1; }
[[ -f "${cx_bin_path}" ]] || { echo "Error: ${cx_bin_path} missing after build"; exit 1; }

# --- Read bundle configuration from Cargo.toml ---
# Same extraction as bundle-mac and bundle-deb: [package.metadata.bundle] in
# apps/desktop/manox/Cargo.toml is the single source of truth.
bundle_toml="apps/desktop/manox/Cargo.toml"
read_bundle_value() {
    local section="$1" key="$2"
    awk -v section="$section" -v key="$key" '
        $0 == "[" section "]" { in_section = 1; next }
        /^\[/ { in_section = 0 }
        in_section && $1 == key && $2 == "=" {
            line = $0
            sub(/^[^"]*"/, "", line)
            sub(/".*$/, "", line)
            print line
            exit
        }
    ' "${bundle_toml}"
}
bundle_id=$(read_bundle_value "package.metadata.bundle" "identifier")
app_name=$(read_bundle_value "package.metadata.bundle" "name")
[[ -n "${bundle_id}" ]] || { echo "Error: no [package.metadata.bundle] identifier in ${bundle_toml}"; exit 1; }
[[ -n "${app_name}" ]] || app_name="Manox"
# version is workspace-inherited; resolve via cargo metadata
app_version=$(cargo metadata --format-version 1 --no-deps 2>/dev/null \
    | python3 -c "import sys,json; pkgs=json.load(sys.stdin)['packages']; \
                   p=[x for x in pkgs if x['name']=='manox']; \
                   print(p[0]['version'] if p else '0.1.0')")
# NEVRA is dash-separated, so a prerelease cargo version (0.2.0-rc.1) has to
# take RPM's tilde form (0.2.0~rc.1), which sorts below the final release. The
# tilde is ANSI-C quoted because a bare one in a substitution would be
# tilde-expanded to $HOME by the shell.
rpm_version="${app_version//-/$'~'}"

pkg_name=$(echo "${app_name}" | tr '[:upper:] ' '[:lower:]-')
exe_name="${pkg_name}"

# --- Lay out the rpmbuild tree ---
topdir="${ROOT}/target/rpm"
spec_path="${topdir}/SPECS/${pkg_name}.spec"
echo "Generating spec at ${spec_path}"
rm -rf "${topdir}"
mkdir -p "${topdir}/BUILD" "${topdir}/BUILDROOT" "${topdir}/RPMS" \
         "${topdir}/SOURCES" "${topdir}/SPECS" "${topdir}/SRPMS"

# --- Desktop entry ---
# Generated as a build source rather than hand-written in the spec, so the
# %install section stays a plain copy like every other packaged file.
desktop_source="${topdir}/SOURCES/${bundle_id}.desktop"
cat > "${desktop_source}" <<DESKTOP
[Desktop Entry]
Type=Application
Name=${app_name}
Exec=${exe_name}
Icon=${bundle_id}
Comment=In-process native agent workbench
Categories=Development;Utility;
Terminal=false
DESKTOP

# --- Icons ---
# Icons are optional repository resources, and rpmbuild refuses to package a
# %files entry that %install never created: collect the install command and the
# file-list line together so the two cannot drift apart.
icon_resources_dir="apps/desktop/manox/resources"
icon_install=""
icon_files=""
add_icon() {
    local source="$1" size="$2"
    [[ -f "${source}" ]] || return 0
    icon_install+="install -D -m 0644 \"%{_manox_root}/${source}\" \"%{buildroot}/usr/share/icons/hicolor/${size}/apps/${bundle_id}.png\""$'\n'
    icon_files+="/usr/share/icons/hicolor/${size}/apps/${bundle_id}.png"$'\n'
}
add_icon "${icon_resources_dir}/app-icon.png" 128x128
add_icon "${icon_resources_dir}/app-icon@2x.png" 256x256

# --- Generate the spec ---
# %{_manox_root} is passed on the rpmbuild command line; the built binaries live
# in the cargo target tree and are not copied into the rpmbuild sources.
cat > "${spec_path}" <<SPEC
# Generated by script/bundle-rpm — the script owns this file.
Name:           ${pkg_name}
Version:        ${rpm_version}
Release:        1%{?dist}
Summary:        GPUI desktop workbench for the manox agent runtime
License:        Proprietary
URL:            https://github.com/dspo/manox-app
Packager:       dspo <dspo@users.noreply.github.com>
Source0:        ${bundle_id}.desktop

# The binaries are already built in the cargo tree, and both bundles that came
# before ship them exactly as cargo left them: no debuginfo subpackage, and no
# brp-strip pass over the symbols (panic backtraces stay readable). For the same
# reason there is no /usr/lib/.build-id symlink — it exists to locate a separate
# debuginfo package, which this bundle never produces (EL9 rpmbuild adds it,
# current Fedora does not).
%global debug_package %{nil}
%global __strip /bin/true
%global _build_id_links none

%description
Single-binary, single-process native agent workbench: conversation UI,
embedded terminal, webview, and the cx external-agent launcher. The
agent runtime itself ships inside the binary; per-user state lives
under ~/.manox/.

%install
install -D -m 0755 "%{_manox_root}/target/${target_dir}/manox" "%{buildroot}/usr/bin/${exe_name}"
install -D -m 0755 "%{_manox_root}/target/${target_dir}/cx" "%{buildroot}/usr/bin/cx"
install -D -m 0644 "%{_sourcedir}/${bundle_id}.desktop" "%{buildroot}/usr/share/applications/${bundle_id}.desktop"
${icon_install}
%files
/usr/bin/${exe_name}
/usr/bin/cx
/usr/share/applications/${bundle_id}.desktop
${icon_files}
# A changelog entry is what rpm derives SOURCE_DATE_EPOCH from; without one
# rpmbuild warns that no build timestamp is available.
%changelog
* $(LC_ALL=C date "+%a %b %d %Y") dspo <dspo@users.noreply.github.com> - ${rpm_version}-1%{?dist}
- Bundle built by script/bundle-rpm
SPEC

# --- Build the RPM ---
# desktop-file-utils and hicolor-icon-theme ship file triggers for
# /usr/share/applications and /usr/share/icons/hicolor that refresh both caches
# on install, so no %post scriptlet is needed here (bundled .debs carry
# postinst/postrm only because dpkg has no such trigger).
echo "Running rpmbuild"
rpmbuild -bb "${spec_path}" \
    --define "_topdir ${topdir}" \
    --define "_manox_root ${ROOT}"

rpm_matches=("${topdir}"/RPMS/*/"${pkg_name}-"*.rpm)
rpm_path="${rpm_matches[0]}"
[[ -f "${rpm_path}" ]] || { echo "Error: rpmbuild succeeded but left no RPM under ${topdir}/RPMS"; exit 1; }

# rpmbuild derives the runtime Requires from the binaries' ELF metadata; an empty
# set means the Red Hat dependency generator never ran, which would ship a
# package that installs without its GTK/WebKit stack and fails at startup.
if ! rpm -qp --requires "${rpm_path}" 2>/dev/null | grep -q '^lib'; then
    echo "Warning: ${rpm_path} declares no ELF library Requires — install rpm-build/redhat-rpm-config and rebuild"
fi

echo ""
echo "Bundle complete: ${rpm_path}"
echo "Binary:   /usr/bin/${exe_name}"
echo "cx CLI:   /usr/bin/cx"
echo "Desktop:  /usr/share/applications/${bundle_id}.desktop"
echo "Install:  sudo dnf install ./${rpm_path#"${ROOT}/"}"
echo ""

if [[ "$install_result" = true ]]; then
    echo "Installing ${rpm_path} system-wide"
    sudo dnf install -y "${rpm_path}"
    echo "Installed: ${pkg_name} ${rpm_version} (${exe_name})"
fi

if [[ "$run_result" = true ]]; then
    echo "Running ${bin_path}"
    "${bin_path}"
fi